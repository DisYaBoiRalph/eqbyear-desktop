{
  // Cloudflare Workers static-assets deployment for eqbyear.com.
  // Deploy: npx wrangler deploy   (from the repo root)
  "name": "eqbyear",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "src",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "eqbyear.com", "custom_domain": true },
    { "pattern": "www.eqbyear.com", "custom_domain": true }
  ]
}
